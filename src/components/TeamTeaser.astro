---
import AuthorAvatar from './AuthorAvatar.astro';
import { team } from '../data/author';
---

<section id="team" class="border-t border-line py-[clamp(4rem,9vw,8rem)]">
  <div class="container-wide">
    <div class="grid items-center gap-12 md:grid-cols-12">
      <!-- Copy -->
      <div class="md:col-span-5">
        <p class="eyebrow reveal mb-4 flex items-center gap-3">
          <span class="inline-block h-px w-8 bg-lime"></span>
          The team
        </p>
        <h2 class="display text-[clamp(2rem,5.5vw,4.2rem)] leading-[1.02]">
          <span class="line-mask"><span>Small studio.</span></span>
          <span class="line-mask"><span><span class="text-accent">Real</span> people.</span></span>
        </h2>
        <p class="reveal mt-6 max-w-md text-pretty leading-relaxed text-ink-muted" style="--reveal-delay:120ms">
          Growth Local is small on purpose. The people you meet are the people
          doing the work, no account managers, no outsourcing. Say hi.
        </p>
        <a href="/team" class="reveal btn btn-primary mt-8" style="--reveal-delay:200ms">
          Meet the team
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 11L11 3M11 3H4.5M11 3V9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      <!-- Member cards -->
      <div class="md:col-span-7">
        <ul class="grid gap-5 sm:grid-cols-2">
          {
            team.map((m, i) => (
              <li class="reveal" style={`--reveal-delay:${i * 100}ms`}>
                <a
                  href="/team"
                  class="member-card group relative flex flex-col items-start gap-5 overflow-hidden rounded-2xl border border-line bg-base-900/40 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:bg-base-800/50"
                >
                  <span class="pointer-events-none absolute right-4 top-4 font-mono text-[0.6rem] uppercase tracking-[0.16em] text-ink-faint opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                    hover ✶
                  </span>
                  <AuthorAvatar person={m} size={92} />
                  <div>
                    <h3 class="font-display text-xl font-semibold tracking-tightest transition-colors duration-300 group-hover:text-accent">
                      {m.name}
                    </h3>
                    <p class="mt-1.5 text-pretty font-mono text-[0.68rem] uppercase leading-relaxed tracking-[0.1em] text-ink-muted">
                      {m.role}
                    </p>
                  </div>
                  <span class="mt-auto inline-flex items-center gap-1.5 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-accent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                    View bio
                    <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 11L11 3M11 3H4.5M11 3V9.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <style>
    /* Reveal each member's real photo when the whole card is hovered
       (not just the avatar), so the whole tile feels interactive. */
    .member-card:hover :global(.avatar-swap .av-memoji) {
      opacity: 0;
      transform: scale(0.96);
    }
    .member-card:hover :global(.avatar-swap .av-photo) {
      opacity: 1;
      transform: scale(1);
    }
  </style>
</section>
