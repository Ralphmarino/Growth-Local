---
// Structured data for individual blog posts. Emits an @graph so entities
// reference each other: Organization (publisher) + Person (author) + BlogPosting.
// FAQPage (when the post declares `faq`) is emitted separately by
// BlogFaqSchema.astro. Rendered into <head> via Base's "head" slot.
import type { CollectionEntry } from 'astro:content';
import { ralph } from '../data/author';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;

const site = (Astro.site ?? new URL('https://growthlocal.com')).toString().replace(/\/$/, '');
const url = `${site}/blog/${post.slug}`;
const published = post.data.pubDate.toISOString();
const modified = (post.data.updatedDate ?? post.data.pubDate).toISOString();
const image = new URL(post.data.heroImage ?? '/og-cover.png', `${site}/`).href;

const organization = {
  '@type': 'Organization',
  '@id': `${site}/#organization`,
  name: 'Growth Local',
  url: `${site}/`,
  logo: `${site}/brand/gl-avatar.png`,
  sameAs: [
    'https://www.linkedin.com/company/growthlocal/',
    'https://www.instagram.com/growthlocal/',
    'https://www.facebook.com/growthlocal',
  ],
};

const person = {
  '@type': 'Person',
  '@id': `${site}/#${ralph.slug}`,
  name: ralph.name,
  jobTitle: ralph.role,
  worksFor: { '@id': `${site}/#organization` },
  url: `${site}/blog/author/${ralph.slug}`,
  sameAs: [ralph.linkedin],
  knowsAbout: [
    'Search Engine Optimization',
    'Generative Engine Optimization',
    'Answer Engine Optimization',
    'Technical SEO',
    'Local SEO',
    'Content Strategy',
  ],
};

const blogPosting = {
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  mainEntityOfPage: url,
  url,
  headline: post.data.title.slice(0, 110),
  description: post.data.description,
  datePublished: published,
  dateModified: modified,
  inLanguage: 'en-US',
  image,
  ...(post.data.category ? { articleSection: post.data.category } : {}),
  ...(post.data.tags?.length ? { keywords: post.data.tags.join(', ') } : {}),
  author: { '@id': `${site}/#${ralph.slug}` },
  publisher: { '@id': `${site}/#organization` },
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [organization, person, blogPosting],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
